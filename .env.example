# Copy to .env and fill in values

DB_SERVER=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

POLL_INTERVAL=5

# EHLLAPI session short ID (default A — check PCOMM session list)
EHLLAPI_SESSION=A

# DLL path (IBM PCOMM default — change if different)
DLL_DIR=C:\Program Files (x86)\IBM\Client Access\Emulator

# Login — set SKIP_LOGIN=true if already signed in and at DEQ05161
SKIP_LOGIN=false
AS400_USER=
AS400_PASS=
PBASMT_USER=
PBASMT_PASS=
AS400_MENU_OPTION=         # e.g. 16-MP-14 (each segment typed + Enter)
PBASMT_CHECK_PASS=
PBASMT_SECTION_CODE=

# Confirm mode — show modal on IQC web site before pressing Enter (CHECK)
CONFIRM_MODE=false
CONFIRM_HOST=localhost:3070        # IQC sampling web site host:port
CONFIRM_TIMEOUT_SEC=120

# Field positions — calibrate with read_screen() dump if defaults are wrong
# DEQ05161: INVOICE NO field (confirmed from cursor 08/041 with 11-char value)
INV_FIELD_ROW=8
INV_FIELD_COL=30

# List screen: OPT column where X is typed
LIST_OPT_COL=1

# DEQ05172: VISUAL RESULT and DIM RESULT field positions
VISUAL_ROW=11
VISUAL_COL=24
DIM_RESULT_ROW=13
DIM_RESULT_COL=24
